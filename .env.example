# FastAPI application configuration
APP_NAME=PT-LLM-Assistant
HOST=0.0.0.0
PORT=8000

# Database configuration
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/db

# LLM provider parameters
# Supported providers: openai (for any remote provider follow openai schema), ollama
LLM_PROVIDER=openai
LLM_MODEL=google/gemini-2.5-flash-preview-09-2025
LLM_API_KEY=sk-your-api-key
# Leave empty unless you run against a self-hosted or alternative endpoint
LLM_BASE_URL=https://openrouter.ai/api/v1
# Explicit error identifier to safely separate LLM errors 
LLM_ERROR_CODE=1337

# LangSmith (optional, for tracing)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_TRACING=true

# Embedding configuration
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# Chat configuration
CHAT_HISTORY_LENGTH=50
